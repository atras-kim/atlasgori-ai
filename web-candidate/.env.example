# Copy to .env.local. Never commit real secrets. Use separate ATLAS credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ATLAS_APP_URL=http://127.0.0.1:4317
# 32 random bytes encoded as base64, generated by your secret manager.
ATLAS_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AI is opt-in; users must enable it for each connected mailbox.
ATLAS_AI_PROVIDER=disabled
ANTHROPIC_API_KEY=
ATLAS_AI_MODEL=claude-sonnet-4-6
# Optional Brave Search API for source-backed sourcing; no fabricated results.
BRAVE_SEARCH_API_KEY=
# Frankfurter is a reference/daily feed, not a real-time trading quote.
ATLAS_FX_PROVIDER=frankfurter
